{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbo.invalid/schemas/edition-envelope.schema.json",
  "title": "ABBO APS signed edition envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "kid", "payload", "signature"],
  "properties": {
    "format": {"const": "ABBO-EDITION-1"},
    "kid": {
      "type": "string",
      "pattern": "^k[0-9]{4}-[0-9]{2}(?:-[A-Za-z0-9_-]{1,16})?$",
      "maxLength": 32
    },
    "payload": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "minLength": 16,
      "maxLength": 8192
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
