{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abbo.invalid/schemas/keyring.schema.json",
  "title": "ABBO APS NFC public keyring",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keys"],
  "properties": {
    "schemaVersion": {"const": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "base64url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "alg", "status", "createdAt", "jwk"],
      "properties": {
        "kid": {
          "type": "string",
          "pattern": "^k[0-9]{4}-[0-9]{2}(?:-[A-Za-z0-9_-]{1,16})?$",
          "maxLength": 32
        },
        "alg": {"const": "ES256"},
        "status": {"enum": ["active", "retired", "compromised"]},
        "createdAt": {"type": "string", "format": "date-time"},
        "jwk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kty", "crv", "x", "y", "ext", "key_ops"],
          "properties": {
            "kty": {"const": "EC"},
            "crv": {"const": "P-256"},
            "x": {"$ref": "#/$defs/base64url32"},
            "y": {"$ref": "#/$defs/base64url32"},
            "ext": {"const": true},
            "key_ops": {
              "type": "array",
              "prefixItems": [{"const": "verify"}],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      }
    }
  }
}
